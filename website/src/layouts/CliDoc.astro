---
import type { CollectionEntry } from 'astro:content';
import CliSearch from '~/components/CliSearch.astro';
import CliSidebar from '~/components/CliSidebar.astro';
import cliReference from '~/data/cli-reference.json';
import Base from '~/layouts/Base.astro';
import { buildCliSearchItems, cliSlugFor } from '~/lib/cliDocs';
import { type Locale, t } from '~/lib/i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'cli'>;
  allDocs: CollectionEntry<'cli'>[];
  locale: Locale;
  headings: Heading[];
}

const { entry, allDocs, locale, headings } = Astro.props;
const copy = t(locale).cli;
const activeSlug = cliSlugFor(entry.id);
const referenceTerms = JSON.stringify(cliReference);
const searchItems = buildCliSearchItems(allDocs, locale, referenceTerms);
const serializedSearchItems = JSON.stringify(searchItems).replaceAll('<', '\\u003c');
const pageHeadings = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---

<Base title={`${entry.data.title} — ${copy.titleSuffix}`} description={entry.data.description} locale={locale}>
  <div
    class="container cli-page"
    data-cli-docs
    data-copy-label={copy.copy.label}
    data-copy-success={copy.copy.success}
    data-copy-error={copy.copy.error}
  >
    <textarea hidden readonly data-cli-search-index>{serializedSearchItems}</textarea>
    <header class="cli-hero">
      <div>
        <p class="eyebrow">{copy.label}</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
      </div>
      <div class="terminal-mark" aria-hidden="true">
        <span>$</span> lingua {activeSlug === 'getting-started' ? '--help' : activeSlug}
      </div>
    </header>

    <aside class="desktop-sidebar">
      <CliSearch locale={locale} instance="desktop" />
      <CliSidebar entries={allDocs} activeSlug={activeSlug} locale={locale} />
    </aside>

    <section class="mobile-tools" aria-label={copy.navLabel}>
      <CliSearch locale={locale} instance="mobile" />
      <details>
        <summary>{copy.navToggle}</summary>
        <CliSidebar entries={allDocs} activeSlug={activeSlug} locale={locale} />
      </details>
    </section>

    <article class="cli-article">
      <div class="release-note">
        <span aria-hidden="true">i</span>
        <p>{copy.releaseNote}</p>
      </div>
      <div class="prose cli-prose">
        <slot />
      </div>
    </article>

    {
      pageHeadings.length > 0 && (
        <aside class="page-outline" aria-label={copy.onThisPage}>
          <p>{copy.onThisPage}</p>
          <ol>
            {pageHeadings.map(heading => (
              <li class:list={[heading.depth === 3 && 'nested']}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .cli-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    min-width: 0;
  }
  .cli-hero {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 82% 20%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--color-bg-elevated) 94%, transparent), var(--color-bg-sunken));
    overflow: hidden;
  }
  .cli-hero h1 {
    max-width: 17ch;
    margin: 0.35rem 0 0.7rem;
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }
  .cli-hero p:not(.eyebrow) {
    max-width: 62ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }
  .terminal-mark {
    align-self: end;
    width: fit-content;
    max-width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    border-radius: var(--radius);
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg-sunken) 92%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }
  .terminal-mark span {
    color: var(--color-accent);
  }
  .desktop-sidebar {
    display: none;
  }
  .mobile-tools {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-sunken);
  }
  .mobile-tools details {
    border-top: 1px solid var(--color-border);
    padding-top: 0.85rem;
  }
  .mobile-tools summary {
    cursor: pointer;
    color: var(--color-text);
    font-weight: 700;
  }
  .mobile-tools details :global(.cli-nav) {
    margin-top: 1rem;
  }
  .cli-article {
    min-width: 0;
  }
  .release-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    margin-bottom: 2rem;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-accent-muted) 16%, transparent);
  }
  .release-note span {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    color: var(--color-bg);
    background: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
  }
  .release-note p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .cli-prose {
    max-width: 78ch;
  }
  .cli-prose :global(h2[id]),
  .cli-prose :global(h3[id]) {
    scroll-margin-top: 7rem;
  }
  .cli-prose :global(pre) {
    position: relative;
    padding-top: 2.8rem;
  }
  .cli-prose :global(.cli-copy-button) {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 0.28rem 0.55rem;
    color: var(--color-text-muted);
    background: var(--color-bg-elevated);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .cli-prose :global(table) {
    display: block;
    width: 100%;
    border-collapse: collapse;
    overflow-x: auto;
  }
  .cli-prose :global(th),
  .cli-prose :global(td) {
    border-bottom: 1px solid var(--color-border);
    padding: 0.7rem 0.8rem;
    text-align: left;
    vertical-align: top;
  }
  .cli-prose :global(th) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .page-outline {
    display: none;
  }
  @media (min-width: 720px) {
    .cli-hero {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
  @media (min-width: 1080px) {
    .cli-page {
      grid-template-columns: 230px minmax(0, 1fr) 170px;
      column-gap: clamp(2rem, 4vw, 4rem);
      row-gap: 2.5rem;
    }
    .cli-hero {
      grid-column: 1 / -1;
    }
    .desktop-sidebar {
      display: flex;
      position: sticky;
      top: 92px;
      align-self: start;
      flex-direction: column;
      gap: 1.5rem;
      min-width: 0;
      max-height: calc(100vh - 112px);
      padding-right: 0.35rem;
      overflow-y: auto;
      scrollbar-gutter: stable;
    }
    .mobile-tools {
      display: none;
    }
    .page-outline {
      display: block;
      position: sticky;
      top: 92px;
      align-self: start;
      min-width: 0;
      max-height: calc(100vh - 112px);
      padding-right: 0.35rem;
      overflow-y: auto;
      scrollbar-gutter: stable;
    }
    .page-outline p {
      margin: 0 0 0.65rem;
      color: var(--color-text-subtle);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .page-outline ol {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .page-outline li.nested {
      padding-left: 0.75rem;
    }
    .page-outline a {
      display: block;
      color: var(--color-text-subtle);
      font-size: var(--text-xs);
      line-height: 1.4;
    }
    .page-outline a:hover {
      color: var(--color-accent);
    }
  }
</style>
