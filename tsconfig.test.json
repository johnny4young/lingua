// Type-check gate for `tests/**`, widened one directory at a time.
//
// The root tsconfig.json only includes `src/**`, and `pnpm test` runs vitest
// in transpile-only mode, so neither default gate type-checks anything under
// `tests/`. A `// @ts-expect-error` there is inert until its file is listed
// below, which is why the compile guards (branded-id swaps, architecture
// fixtures) were the first entries.
//
// Whole directories follow, cheapest first. Measured with a scratch config
// per directory, last at a342ee98 (2026-09-16), so re-measure before trusting
// these for scope. Already in: cli, docs, runners, main. Remaining: build 30
// errors (plus 14 in the root `.mts` configs it pulls in), shared 51,
// scripts 53, hooks 80, components 95, stores 214.
//
// Rules for widening:
//  - one directory per change, with its errors fixed rather than silenced:
//    no `any`, no `@ts-ignore`, no weaker assertions, no relaxed strictness;
//  - if the honest fix needs a production type change, stop and raise it;
//  - keep the `typecheck:tests` CI step well under a minute.

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // A child `paths` replaces the parent's, so `@/*` is repeated here.
    // `#src/*` mirrors the test-only alias in vitest.config.mts; it stays out
    // of the root config because no production bundle defines it.
    // tests/build/testTypecheckPaths.test.ts checks both copies.
    "paths": {
      "@/*": ["./src/renderer/*"],
      "#src/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types.d.ts",
    "forge.env.d.ts",
    // Compile guards. The `@ts-expect-error` swap matrix inside
    // projectCapabilitiesBrand.test.ts is inert unless it is checked: a brand
    // reverted to a bare string would let every swap compile.
    "tests/main/projectCapabilitiesBrand.test.ts",
    "tests/hooks/useTelemetry.types.test.ts",
    "tests/build/rendererTypeBoundaries.test.ts",
    "tests/build/ambientTypeBoundaries.test.ts",
    "tests/shared/telemetryArchitecture.test.ts",
    "tests/components/commandPaletteArchitecture.test.ts",
    "tests/workers/workerArchitecture.test.ts",
    "tests/cli/**/*.ts",
    "tests/cli/**/*.tsx",
    "tests/docs/**/*.ts",
    "tests/docs/**/*.tsx",
    "tests/runners/**/*.ts",
    "tests/runners/**/*.tsx",
    "tests/main/**/*.ts",
    "tests/main/**/*.tsx"
  ],
  "exclude": ["node_modules", "out", ".vite", "dist"]
}
