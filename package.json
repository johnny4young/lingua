{
  "name": "lingua",
  "productName": "Lingua",
  "version": "1.4.1",
  "description": "Desktop application for running code in multiple languages with WebAssembly support",
  "packageManager": "pnpm@11.3.0",
  "main": ".vite/build/main.js",
  "bin": {
    "lingua": "./dist/cli/lingua.cjs"
  },
  "private": true,
  "scripts": {
    "dev:web": "vite --config vite.web.config.mts --port 5174",
    "dev:web:pro": "node ./scripts/dev-web-pro.mjs",
    "dev:desktop": "node ./scripts/run-electron-desktop.mjs",
    "dev:desktop:sync": "node ./scripts/run-electron-desktop.mjs --sync-main",
    "dev:desktop:pro": "node ./scripts/dev-desktop-pro.mjs",
    "dev:desktop:prod": "node ./scripts/dev-desktop-prod.mjs",
    "build:web": "node ./scripts/build-web.mjs",
    "build:cli": "node ./scripts/build-cli.mjs",
    "package:cli": "node ./scripts/package-cli.mjs",
    "check:cli-publication": "node ./scripts/verify-cli-publication.mjs",
    "check:cli-publish-prereqs": "node ./scripts/cli-publish-prerequisites.mjs",
    "check:windows-signing-prereqs": "node ./scripts/windows-signing-prerequisites.mjs",
    "distribution:status": "node ./scripts/distribution-readiness.mjs",
    "preview:web": "vite preview --config vite.web.config.mts",
    "smoke:project-templates": "node ./scripts/smoke-project-templates.mjs",
    "smoke:desktop": "node ./scripts/run-desktop-smoke.mjs",
    "smoke:desktop:stagewright": "node ./scripts/run-electron-stagewright-smoke.mjs",
    "smoke:desktop:offline": "node ./scripts/run-desktop-smoke.mjs --offline",
    "smoke:desktop:packaged": "node ./scripts/run-desktop-smoke.mjs --offline --against-packaged out-builder",
    "build:runtime-assets": "node --experimental-strip-types ./scripts/build-runtime-asset-manifest.mjs --write",
    "check:runtime-assets": "node --experimental-strip-types ./scripts/build-runtime-asset-manifest.mjs",
    "sbom:release": "node ./scripts/write-release-compliance-artifacts.mjs",
    "check:licenses": "node ./scripts/check-third-party-licenses.mjs --check",
    "license:report": "node ./scripts/check-third-party-licenses.mjs --format markdown --write docs/THIRD_PARTY_LICENSE_REPORT.md",
    "compliance:release": "node ./scripts/write-release-compliance-artifacts.mjs",
    "check:release-infra": "node ./scripts/check-release-infra.mjs",
    "release:preflight": "node ./scripts/release-preflight.mjs",
    "check:license-rotation": "node ./scripts/assert-license-key-rotation.mjs",
    "check:prod-audit": "node ./scripts/assert-prod-audit.mjs",
    "check:bundled-audit": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/assert-bundled-audit.mjs",
    "performance:report": "node ./scripts/performance-report.mjs",
    "performance:activation": "node ./scripts/measure-activation.mjs",
    "performance:baseline": "node ./scripts/performance-report.mjs --write-baseline",
    "check:performance": "node ./scripts/performance-report.mjs --check",
    "changelog:draft": "node ./scripts/changelog-draft.mjs",
    "changelog:check": "node ./scripts/changelog-check.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude \"**/*.bench.test.ts\"",
    "check:deadcode": "knip",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:e2e:web": "PLAYWRIGHT_BROWSERS_PATH=0 node ./scripts/run-playwright-web-validation.mjs",
    "test:smoke:web:license": "vitest run tests/smoke/licenseWebSmoke.test.tsx",
    "test:watch": "vitest",
    "lint": "oxlint && pnpm run check:telemetry-call-sites",
    "check:telemetry-call-sites": "node ./scripts/check-telemetry-call-sites.mjs",
    "check:i18n": "node ./scripts/check-i18n.mjs",
    "check:i18n:copy": "node ./scripts/check-renderer-copy.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "prepare:node-pty": "node ./scripts/ensure-node-pty-helper-mode.mjs",
    "build:desktop-bundles": "pnpm run prepare:node-pty && node ./scripts/build-desktop-bundles.mjs",
    "package:desktop": "pnpm run build:desktop-bundles && electron-builder --dir -c.mac.identity=-",
    "make:desktop": "pnpm run build:desktop-bundles && electron-builder --publish never",
    "make:desktop:mac": "pnpm run build:desktop-bundles && electron-builder --mac --publish never",
    "make:desktop:linux": "pnpm run build:desktop-bundles && electron-builder --linux --publish never",
    "make:desktop:win": "pnpm run build:desktop-bundles && electron-builder --win --publish never",
    "publish:desktop": "pnpm run build:desktop-bundles && electron-builder --publish always",
    "prepare": "node ./scripts/ensure-node-pty-helper-mode.mjs && node ./scripts/build-cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnny4young/lingua"
  },
  "keywords": [
    "code-runner",
    "electron",
    "monaco-editor",
    "wasm",
    "multi-language"
  ],
  "author": {
    "name": "johnny4young",
    "email": "asesordeprogramacion@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/windows-sign": "2.1.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/client": "2.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@ruby/3.4-wasm-wasi": "2.10.1",
    "@ruby/wasm-wasi": "2.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spark-md5": "^3.0.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.5.6",
    "cron-parser": "^5.10.0",
    "cronstrue": "^3.26.0",
    "dompurify": "^3.4.15",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "esbuild-wasm": "^0.28.0",
    "fengari": "^0.1.5",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "knip": "^6.35.1",
    "lucide-react": "^1.44.0",
    "lz-string": "1.5.0",
    "magic-string": "^1.3.1",
    "marked": "^18.0.12",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "oxc-parser": "0.149.0",
    "oxlint": "1.82.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "pyodide": "^0.29.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-resizable-panels": "^4.12.4",
    "spark-md5": "^3.0.2",
    "sql-formatter": "^15.8.2",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "undici": "^8.10.2",
    "undici-types": "^7.24.6",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3",
    "vite": "~8.2.2",
    "vitest": "5.0.0",
    "wrangler": "^4.131.0",
    "ws": "^8.21.1",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "brace-expansion@1.1.15": "^1.1.18",
    "brace-expansion@2.1.1": "^2.1.4",
    "brace-expansion@5.0.6": "^5.0.9",
    "dompurify": "$dompurify",
    "fast-uri": "^3.1.6",
    "ip-address": "^10.3.1",
    "js-yaml": "$js-yaml",
    "nanoid": "^3.3.18",
    "hono": "^4.12.34",
    "postcss": "^8.5.25",
    "undici@7": "^7.29.0",
    "node-abi@4": "^4.35.0",
    "@xmldom/xmldom@0.8": "^0.8.15",
    "@xmldom/xmldom@0.9": "^0.9.12",
    "ws": "^8.21.1"
  }
}
